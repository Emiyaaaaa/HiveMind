AGENTFLOW_DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow
AGENTFLOW_REDIS_URL=redis://localhost:6379/0
AGENTFLOW_LOG_LEVEL=INFO
AGENTFLOW_DEFAULT_ADAPTER=echo
AGENTFLOW_OPENAI_API_KEY=
AGENTFLOW_OPENAI_BASE_URL=https://api.openai.com/v1

# Run-job queue wire protocol. Must match the Java side's AGENTFLOW_JOBS_IMPL.
# `streams` (default): at-least-once via XADD/XREADGROUP/XACK/XAUTOCLAIM.
# `list`: legacy LPUSH/BRPOP. Kept for rollback.
# `temporal`: start a durable Temporal workflow per run (ultra-long Runs).
AGENTFLOW_JOBS_IMPL=streams
AGENTFLOW_REDIS_QUEUE_IMPL=streams

# Temporal backend (set when AGENTFLOW_JOBS_IMPL=temporal)
AGENTFLOW_TEMPORAL_TARGET=localhost:7233
AGENTFLOW_TEMPORAL_NAMESPACE=default
AGENTFLOW_TEMPORAL_TASK_QUEUE=agentflow-runs
AGENTFLOW_TEMPORAL_ACTIVITY_HEARTBEAT_SECONDS=30
AGENTFLOW_TEMPORAL_ACTIVITY_START_TO_CLOSE_SECONDS=604800
AGENTFLOW_TEMPORAL_ACTIVITY_MAX_ATTEMPTS=5
AGENTFLOW_JOB_STREAM_GROUP=agentflow-workers
AGENTFLOW_JOB_STREAM_CLAIM_IDLE_MS=60000
AGENTFLOW_JOB_STREAM_MAX_DELIVERIES=5

# Max run jobs executed in parallel per worker process (default 1).
AGENTFLOW_WORKER_CONCURRENCY=1

# Queue depth / consumer-delay monitoring (Redis Streams worker only).
AGENTFLOW_JOB_QUEUE_MONITOR_ENABLED=true
AGENTFLOW_JOB_QUEUE_MONITOR_INTERVAL_SECONDS=30
AGENTFLOW_JOB_QUEUE_CONSUMER_DELAY_ALERT_SECONDS=300
AGENTFLOW_JOB_QUEUE_DEPTH_ALERT_THRESHOLD=100
AGENTFLOW_WORKER_JOB_P95_ALERT_SECONDS=60
AGENTFLOW_WORKER_JOB_P95_ALERT_MIN_SAMPLES=10

# Multi-tenant API key auth (off by default). When enabled, /v1/* (except
# health) requires Authorization: Bearer <key> or X-Api-Key.
# Keys are comma-separated key:tenant_id:role (viewer|operator|admin).
AGENTFLOW_AUTH_ENABLED=false
AGENTFLOW_AUTH_API_KEYS=dev-admin:default:admin
